    {
      "path": "meta/D-004.md",
      "type": "decision",
      "role": "reference",
      "ancestry": [
        "code/decision"
      ],
      "title": "D-004 — No lane and no check in the code kit",
      "description": "The kit registers declarations only — types, a fragment, relation labels, templates, skill fragments — because every obligation it states is a shape or section law the kernel already holds, and a lane nothing routes to is a declared key without a consumer.",
      "tags": [
        "meta"
      ],
      "status": "active",
      "inbound": {
        "relation": {
          "decided-by": [
            "wiki/wikiwright-architecture.md"
          ]
        },
        "wikilink": [
          "wiki/wikiwright-architecture.md"
        ]
      }
    },
    {
      "path": "meta/D-005.md",
      "type": "decision",
      "role": "reference",
      "ancestry": [
        "code/decision"
      ],
      "title": "D-005 — A relation is a labelled edge, and coverage is a graph query",
      "description": "Relation items become labelled edges in generated/graph.json through the grammar's edges hook, and graph edges --missing answers coverage from that construction rather than from a grep over the pages.",
      "tags": [
        "meta"
      ],
      "status": "active",
      "inbound": {
        "relation": {
          "decided-by": [
            "wiki/generated-artifacts.md"
          ]
        },
