    {
      "path": "meta/D-008.md",
      "type": "decision",
      "role": "reference",
      "ancestry": [
        "code/decision"
      ],
      "title": "D-008 — A repaired observation needs a recurrence rule and visible evidence status",
      "description": "The first v2 delivery is exercised as one synthetic gardening episode: repair a claim, add a tested rule, refuse its recurrence at the gate, and show changed evidence in read and search.",
