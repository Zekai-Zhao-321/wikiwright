    {
      "path": "meta/D-002.md",
      "type": "decision",
      "role": "reference",
      "ancestry": [
        "code/decision"
      ],
      "title": "D-002 — One trust law: the digest over the package is the boundary",
      "description": "A module is admitted by one machine-local, content-hashed grant over every file of the installed package; the lockfile pin gate and the plugin tier were deleted rather than kept as second laws.",
      "tags": [
        "meta"
      ],
      "status": "active",
