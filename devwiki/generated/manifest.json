    {
      "path": "meta/D-003.md",
      "type": "decision",
      "role": "reference",
      "ancestry": [
        "code/decision"
      ],
      "title": "D-003 — The code kit is unpublished",
      "description": "@wikiwright/kit-code is on no registry; a bundle depends on it by workspace link or by a file: path to packages/kit-code, and engine.json's version range is a loader check, not a lookup.",
      "tags": [
        "meta"
      ],
      "status": "active",
      "inbound": {
