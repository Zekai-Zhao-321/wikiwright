          "meta/D-007.md"
        ]
      }
    },
    {
      "path": "meta/D-007.md",
      "type": "decision",
      "role": "reference",
      "ancestry": [
        "code/decision"
      ],
      "title": "D-007 — Installing is consent; every load proves the module",
      "description": "The machine-local grant and the trust verb are removed: a module a bundle declares and has installed, or carries by a bundle-relative path, runs because it was installed, and every load proves it — the purity scan and the determinism fixture, once per digest in a process — before it judges anything.",
      "tags": [
        "meta"
      ],
      "status": "active",
      "outbound": {
        "wikilink": [
          "meta/D-002.md",
          "meta/D-006.md"
        ]
      },
